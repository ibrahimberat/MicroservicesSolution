{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "JWT": {
    "Secret": "YOUR-SUPER-SECRET-KEY-HERE-MINIMUM-32-CHARS",
    "ValidIssuer": "https://localhost:5001",
    "ValidAudience": "https://localhost:5001"
  },
  "ReverseProxy": {
    "Routes": {
      "auth-route": {
        "ClusterId": "auth-cluster",
        "Match": {
          "Path": "/auth/{**catch-all}"
        },
        "Transforms": [
          { "PathPattern": "/api/{**catch-all}" }
        ]
      },
      "product-route": {
        "ClusterId": "product-cluster",
        "Match": {
          "Path": "/products/{**catch-all}"
        },
        "Transforms": [
          { "PathPattern": "/api/{**catch-all}" }
        ]
      },
      "log-route": {
        "ClusterId": "log-cluster",
        "Match": {
          "Path": "/logs/{**catch-all}"
        },
        "Transforms": [
          { "PathPattern": "/api/{**catch-all}" }
        ]
      }
    },
    "Clusters": {
      "auth-cluster": {
        "Destinations": {
          "auth-destination": {
            "Address": "https://localhost:5002/"
          }
        }
      },
      "product-cluster": {
        "Destinations": {
          "product-destination": {
            "Address": "https://localhost:5003/"
          }
        }
      },
      "log-cluster": {
        "Destinations": {
          "log-destination": {
            "Address": "https://localhost:5004/"
          }
        }
      }
    }
  }
}